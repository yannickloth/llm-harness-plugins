// opencode.jsonc — plugins parcelled out for measurement, 2026-11-07.
//
// WHY: a token-cost review found every project loading 15-27 plugins, none of
// them measured. opencode averages 33.5 model calls/trial vs pi's 18.5, and
// several of these plugins inject context on every message. This is the
// baseline: NO harness plugins. Re-enable one at a time and compare tokens.
//
// graphrag is disabled for every project permanently (user decision).
//
// To re-enable: move one line out of the commented block into "plugin".
// Precedence note: opencode.jsonc wins over opencode.json in the same dir,
// but the .json was removed here so there is only one source of truth.

{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "../llm-harness-plugins/agentmem/opencode"
  ],
  "model": "proxy/lieutenant",
  "small_model": "proxy/sergeant",
  "agent":   {
    "cynic-auditor": {
      "file": "./scientific-writing/agents/cynic-auditor.md",
      "model": "proxy/warrant-officer",
      "mode": "subagent"
    },
