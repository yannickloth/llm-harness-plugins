{
  "$schema": "https://opencode.ai/config.json",
  "instructions": {
    "memory": "./agentmem/prompts/agent-prompt.md"
  },
  "plugin": [
    "./guardrail-chain/opencode/index.ts",
    "./agentmem/opencode/index.ts",
    "./semantic-cache/opencode/index.ts",
    "./tier-router/opencode/index.ts",
    "./agentinsights/opencode/index.ts",
    "./knowledge-graph/opencode/index.ts",
    "./prompt-registry/opencode/index.ts",
    "./typst-toolkit/opencode/index.ts",
    "./latex-toolkit/opencode/index.ts",
    "./general-skills/opencode/index.ts"
  ],
  "agent": {
    "memory-keeper": {
      "model": "openai/gpt-4.1-nano",
      "mode": "subagent",
      "steps": 5,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "memory-dreamer": {
      "model": "openai/gpt-4.1-nano",
      "mode": "subagent",
      "steps": 10,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "command": {
    "save-memories": {
      "description": "Extract learnings from conversation to memory",
      "run": "opencode run --agent memory-keeper -- Extract non-derivable learnings from the conversation and persist to .agentmem/."
    },
    "dream": {
      "description": "Run memory consolidation",
      "run": "opencode run --agent memory-dreamer -- Run memory consolidation: merge, deduplicate, prune, link."
    },
    "init-memory": {
      "description": "Bootstrap memory from git history",
      "run": "java --class-path agentmem/build/classes --source 25 agentmem/MemorySystem.java bootstrap .agentmem ."
    },
    "forget-memory": {
      "description": "Explicitly forget a memory. Usage: /forget-memory <name>",
      "run": "java --class-path agentmem/build/classes --source 25 agentmem/MemorySystem.java delete .agentmem $ARG"
    },
    "skip-review": {
      "description": "Skip this week's memory review",
      "run": "echo 'Review skipped.'"
    },
    "insights": {
      "description": "Generate session analytics + AI-powered insights report",
      "run": "java --class-path agentinsights/build/classes eu.infolead.llmhp.insights.InsightsCli run --session-dir .opencode/sessions --insights-dir .agentmem/insights --platform opencode"
    }
  }
}
