{
  "$schema": "https://opencode.ai/config.json",
  "instructions": {
    "memory": "./agentmem/prompts/agent-prompt.md"
  },
  "plugin": [
    "./guardrail-chain/opencode/index.ts",
    "./session-lifecycle/opencode/index.ts",
    "./agentmem/opencode/index.ts",
    "./semantic-cache/opencode/index.ts",
    "./tier-router/opencode/index.ts",
    "./datetime-inject/opencode/index.ts",
    "./agentinsights/opencode/index.ts",
    "./knowledge-graph/opencode/index.ts",
    "./graphrag/opencode/index.ts",
    "./prompt-registry/opencode/index.ts",
    "./typst-toolkit/opencode/index.ts",
    "./latex-toolkit/opencode/index.ts",
    "./general-skills/opencode/index.ts",
    "./natural-prose/opencode/index.ts",
    "./permission-modes/opencode/index.ts",
    "./system-message-merge/opencode/index.ts",
    "./sdlc-guardrails/opencode/index.ts"
  ],
  "agent": {
    "memory-keeper": {
      "model": "openai/gpt-4.1-nano",
      "mode": "subagent",
      "steps": 5,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "memory-dreamer": {
      "model": "openai/gpt-4.1-nano",
      "mode": "subagent",
      "steps": 10,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "natural-prose-auditor": {
      "file": "./natural-prose/agents/natural-prose-auditor.md",
      "mode": "subagent"
    },
    "natural-prose-naturalizer": {
      "file": "./natural-prose/agents/natural-prose-naturalizer.md",
      "mode": "subagent"
    },
    "natural-prose-perplexity-judge": {
      "file": "./natural-prose/agents/natural-prose-perplexity-judge.md",
      "mode": "subagent"
    }
  },
  "command": {
    "save-memories": {
      "description": "Extract learnings from conversation to memory",
      "template": "Run this: opencode run --agent memory-keeper -- Extract non-derivable learnings from the conversation and persist to .agentmem/."
    },
    "dream": {
      "description": "Run memory consolidation",
      "template": "Run this: opencode run --agent memory-dreamer -- Run memory consolidation: merge, deduplicate, prune, link."
    },
    "init-memory": {
      "description": "Bootstrap memory from git history",
      "template": "Run this: java --class-path agentmem/build/classes --source 25 agentmem/MemorySystem.java bootstrap .agentmem ."
    },
    "forget-memory": {
      "description": "Explicitly forget a memory. Usage: /forget-memory <name>",
      "template": "Run this: java --class-path agentmem/build/classes --source 25 agentmem/MemorySystem.java delete .agentmem $ARG"
    },
    "skip-review": {
      "description": "Skip this week's memory review",
      "template": "Run this: echo 'Review skipped.'"
    },
    "insights": {
      "description": "Generate session analytics + AI-powered insights report",
      "template": "Run this: java --class-path agentinsights/build/classes eu.infolead.llmhp.insights.InsightsCli run --session-dir .opencode/sessions --insights-dir .agentmem/insights --platform opencode"
    },
    "sdlc-fix": {
      "description": "Mark this session as a fix task. While active, edits to test files are blocked unless they add coverage (R3).",
      "template": "Run this: echo 'Fix scope ON — test files are protected against weakening.'"
    },
    "sdlc-plan": {
      "description": "Return this session to normal build scope, disabling test-protection (R3).",
      "template": "Run this: echo 'Fix scope OFF — normal build scope.'"
    }
  }
}
